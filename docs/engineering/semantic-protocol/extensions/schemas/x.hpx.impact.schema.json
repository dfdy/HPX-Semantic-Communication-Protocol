{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HPX proposal impact annotation",
  "type": "object",
  "properties": {
    "components": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "components",
    "risk"
  ],
  "additionalProperties": false
}
